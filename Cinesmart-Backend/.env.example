# CineSmart backend environment variables. Copy to your run configuration / shell.
# Placeholders only: never commit real values.

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/Test
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# JWT signing key: Base64 of 32 random bytes
# PowerShell: [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256}) -as [byte[]])
JWT_SECRET=change-me

# SMTP (Ethereal for development)
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_USERNAME=change-me@ethereal.email
MAIL_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend (Vite dev server)
FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173

# Optional: SQL logging for local development
# SPRING_PROFILES_ACTIVE=dev
